{
  "name": "hedge-website",
  "version": "1.0.0",
  "description": "Hedge Wears official marketing website",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env server.js || node server.js",
    "dev": "nodemon --exec 'node --env-file=.env server.js || node server.js'",
    "build": "node scripts/build.js",
    "start:prod": "pm2 start server.js --name hedge-website",
    "pm2:start": "npm run pm2:start:app && pm2 save",
    "pm2:start:app": "( npm run build && pm2 stop ${PM2_APP_NAME:-dev-hedge-site} >/dev/null 2>&1 || true; pm2 delete ${PM2_APP_NAME:-dev-hedge-site} >/dev/null 2>&1 || true; sleep 0.5 && pm2 start 'node --env-file=.env server.js' --name ${PM2_APP_NAME:-dev-hedge-site} ) || pm2 restart ${PM2_APP_NAME:-dev-hedge-site}",
    "pm2:restart": "npm run pm2:start"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "nodemailer": "^9.0.3",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "uglify-js": "^3.19.1"
  }
}
