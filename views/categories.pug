extends layout

block pageTitle
  title Shop by Category — Hedge Wears

block metaDesc
  meta(name='description' content='Browse all fashion categories on Hedge Wears — bags, shoes, dresses, jewelry and more from African designers.')

block structuredData
  +orgAndWebsite()
  +breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Categories', path: '/categories' }])
  +jsonld({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': 'https://hedgewears.com/categories#collection',
    name: 'Shop by Category — Hedge Wears',
    description: 'Browse Hedge Wears by category — apparel, footwear, and accessories from African designers, priced in HedgeCoin (HGC).',
    url: 'https://hedgewears.com/categories',
    isPartOf: { '@id': 'https://hedgewears.com/#website' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: (categories || []).map(function(c, i) {
        return {
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          url: webShopUrl + '/?categories=' + c._id
        };
      })
    }
  })

block content

  //- ─── PAGE HERO ─────────────────────────────────────────────────────────────
  section.page-hero.section
    .container
      .page-hero-inner.page-hero-inner--centered
        span.section-eyebrow Browse the range
        h1.page-hero-title Shop by Category
        p.page-hero-subtitle From everyday essentials to statement pieces — find it by category.

  //- ─── CATEGORY GRID ─────────────────────────────────────────────────────────
  section.categories-page.section
    .container
      - const fallbackCategories = [{name: "Women's Bags", gender: "FEMALE", description: "Structured totes, crossbodies and clutches from African designers.", photo: ('/img/brand/hedge-15.jpg?v=' + version)}, {name: "Women's Shoes", gender: "FEMALE", description: "Heels, mules, and sandals crafted for everyday elegance.", photo: ('/img/brand/hedge-16.jpg?v=' + version)}, {name: "Men's Bags", gender: "MALE", description: "Duffels, backpacks, and briefcases built to last.", photo: ('/img/brand/hedge-18.jpg?v=' + version)}, {name: "Men's Shoes", gender: "MALE", description: "Oxfords, sneakers, and loafers with intentional design.", photo: ('/img/brand/hedge-19.jpg?v=' + version)}, {name: "Women's Clothing", gender: "FEMALE", description: "Dresses, blouses, and wide-leg trousers with cultural flair.", photo: ('/img/brand/hedge-20.jpg?v=' + version)}, {name: "Men's Clothing", gender: "MALE", description: "Shirts, polo tops, and tailored trousers for every occasion.", photo: ('/img/brand/hedge-21.jpg?v=' + version)}]
      .categories-grid.categories-grid--large
        if categories && categories.length > 0
          each category in categories
            - const catImg = category.photo || ('/img/brand/hedge-22.jpg?v=' + version)
            - const truncDesc = category.description ? category.description.slice(0, 80) + (category.description.length > 80 ? '…' : '') : ''
            a.category-card.category-card--large(href=webShopUrl + '/?categories=' + category._id target='_blank' rel='noopener')
              .category-card-img-wrap
                img.category-card-img(src=catImg alt=category.name + ' category' loading='lazy')
              .category-card-info
                span.category-card-name= category.name
                if truncDesc
                  p.category-card-desc= truncDesc
                span.category-card-cta Explore →
        else
          each cat in fallbackCategories
            a.category-card.category-card--large(href=webShopUrl + '/?productGender=' + cat.gender target='_blank' rel='noopener')
              .category-card-img-wrap
                img.category-card-img(src=cat.photo alt=cat.name + ' category' loading='lazy')
              .category-card-info
                span.category-card-name= cat.name
                p.category-card-desc= cat.description
                span.category-card-cta Explore →

  //- ─── SHOP BY STYLE (TAGS) ──────────────────────────────────────────────────
  if tags && tags.length > 0
    section.tags-section.section.section--muted
      .container
        .section-header
          span.section-eyebrow Shop by style
          h2.section-title Browse by Tag
        .tags-grid
          each tag in tags
            a.tag-card(href=webShopUrl + '/?tags=' + tag._id target='_blank' rel='noopener')
              span.tag-card-name= tag.name
              span.tag-card-arrow →
