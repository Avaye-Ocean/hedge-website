include partials/jsonld

doctype html
html(lang='en')
  head
    //- Per-page description/title fall back to sensible site-wide defaults so
    //- every page still has unique, meaningful metadata even if a route omits them.
    - var pageDescription = description || 'Hedge Wears — African creativity on the global stage. Discover fashion from local designers, every piece priced in HedgeCoin with your local currency always in view.'
    - var pageTitleText = title ? title + ' — Hedge Wears' : 'Hedge Wears'
    - var canonicalUrl = 'https://hedgewears.com' + (path || '')
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    meta(name='theme-color' content='#c15006')
    meta(name='robots' content='index, follow, max-image-preview:large')
    block pageTitle
      title= pageTitleText
    block metaDesc
      meta(name='description' content=pageDescription)
    block metaKeywords
      meta(name='keywords' content='Hedge Wears, African fashion, HedgeCoin, HGC, premium clothing, footwear, accessories, Lagos, Nigeria, luxury fashion')
    meta(property='og:title' content=pageTitleText)
    meta(property='og:description' content=pageDescription)
    meta(property='og:type' content='website')
    meta(property='og:image' content=og_image || 'https://hedgewears.com/img/brand/hedge-10.jpg')
    meta(property='og:image:width' content='1200')
    meta(property='og:image:height' content='630')
    meta(name='twitter:card' content='summary_large_image')
    meta(name='twitter:title' content=pageTitleText)
    meta(name='twitter:description' content=pageDescription)
    meta(name='twitter:image' content=og_image || 'https://hedgewears.com/img/brand/hedge-10.jpg')
    meta(property='og:url' content=canonicalUrl)
    meta(property='og:site_name' content='Hedge Wears')
    meta(property='og:locale' content='en_NG')
    link(rel='canonical' href=canonicalUrl)
    meta(name='twitter:site' content='@hedgewears')

    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Rethink+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap')

    link(rel='stylesheet' href='/css/variables.css?v=' + version)
    link(rel='stylesheet' href='/css/base.css?v=' + version)
    link(rel='stylesheet' href='/css/components.css?v=' + version)
    link(rel='stylesheet' href='/css/layout.css?v=' + version)
    link(rel='stylesheet' href='/css/pages.css?v=' + version)

    link(rel='icon' type='image/svg+xml' href='data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 76 40"><path d="M67.83 0V3.19C67.83 6.65 65.9 9.84 62.83 11.41L42.08 22V0H33.91V3.19C33.91 6.65 31.98 9.84 28.92 11.41L8.17 22V0H0v40h8.17v-3.19C8.17 33.35 10.1 30.16 13.17 28.59L33.92 18v22H42.09v-3.19C42.09 33.35 44.02 30.16 47.08 28.59L67.83 18v22H76V0H67.83Z" fill="%23c15006"/></svg>')

    //- Sitewide Organization + WebSite JSON-LD; specific pages append their own.
    block structuredData
      +orgAndWebsite()

  body
    a.skip-link(href='#main-content') Skip to content
    include partials/nav
    include partials/icons

    main#main-content(tabindex='-1')
      block content

    include partials/footer

    if process.env.NODE_ENV === 'production'
      script(src='/js/main.min.js?v=' + version defer)
    else
      script(src='/js/main.js?v=' + version defer)
