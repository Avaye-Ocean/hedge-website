extends layout

block pageTitle
  title How Shopping Works — Hedge Wears

block metaDesc
  meta(name='description' content='Free to browse. Every product priced in HedgeCoin with your local currency always in view. Shopping on Hedge Wears is simple by design.')

block structuredData
  +orgAndWebsite()
  +breadcrumbs([{ name: 'Home', path: '/' }, { name: 'How Shopping Works', path: '/pricing' }])
  - var pfaqs = []
  - pfaqs.push({ q: 'What is HedgeCoin (HGC)?', a: 'HGC is the currency Hedge Wears uses to sell products — every item on the platform is priced in HGC. It runs on the Vendorstack coin infrastructure that powers the platform and is not a cryptocurrency. You fund your HGC balance from your local currency and every price shows an equivalent in the currency you pick in settings.' })
  - pfaqs.push({ q: 'How do I get HGC?', a: 'Fund your wallet using your local currency — on web or mobile. The conversion rate and any fees are shown before you confirm, and HGC can be converted back to your local currency equivalent at the prevailing rate.' })
  - pfaqs.push({ q: 'Does my HGC expire?', a: 'No. Your HGC balance stays in your wallet until you spend it at checkout or convert it back to your local currency. If you plan to close your account, convert your remaining balance first.' })
  - pfaqs.push({ q: 'What payment methods are accepted?', a: 'All payments are processed through Paystack. You can pay by debit card, credit card, or bank transfer. Your card details are never stored on Hedge Wears servers.' })
  - pfaqs.push({ q: 'How do returns work?', a: 'Return and refund requests are handled through our support team. Contact us at hello@hedgewears.com with your order number and we will assist you promptly.' })
  - pfaqs.push({ q: 'Is shopping on Hedge Wears free?', a: 'Yes. There are no subscription fees, membership fees, or browsing fees. Creating an account and purchasing is completely free. You only pay for the products you buy.' })
  +jsonld({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: pfaqs.map(function(f) {
      return {
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a }
      };
    })
  })

block content

  //- ─── PAGE HERO ─────────────────────────────────────────────────────────────
  section.page-hero.section
    .container
      .page-hero-inner.page-hero-inner--centered
        span.section-eyebrow Simple by design
        h1.page-hero-title Free to browse. Simple to buy.
        p.page-hero-subtitle No subscriptions. No hidden fees. Just fashion — priced in HedgeCoin, with your local currency always in view.

  //- ─── HOW IT WORKS ───────────────────────────────────────────────────────────
  section.how-it-works.section
    .container
      .section-header
        span.section-eyebrow The experience
        h2.section-title How it works
      .how-steps-grid
        .how-step
          .how-step-number 01
          h3.how-step-title Browse &amp; Discover
          p.how-step-desc Explore curated collections across clothing, footwear, and accessories. All pieces are rooted in African heritage and designed to last. No cost to browse.
        .how-step
          .how-step-number 02
          h3.how-step-title Fund Your Wallet
          p.how-step-desc Top up your HGC balance from your local currency &mdash; securely through Paystack by card or bank transfer. The conversion rate and any fees are shown before you confirm.
        .how-step
          .how-step-number 03
          h3.how-step-title Pay in HedgeCoin
          p.how-step-desc Every product is priced and sold in HGC. At checkout you pay from your wallet balance, with the approximate equivalent in your local currency always displayed.
        .how-step
          .how-step-number 04
          h3.how-step-title Convert Back Anytime
          p.how-step-desc Convert HGC back to your local currency equivalent at the prevailing rate whenever you like &mdash; any fees or commissions are shown before you confirm.

  //- ─── SHOPPER FEATURES ───────────────────────────────────────────────────────
  section.shopper-features.section.section--muted
    .container
      .section-header
        span.section-eyebrow Everything included
        h2.section-title What you get as a customer
      .shopper-features-grid
        .shopper-feature-card
          .shopper-feature-icon
            svg(width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true')
              path(d='M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round')
          h3.shopper-feature-title Free to Browse
          p.shopper-feature-desc No account required to explore collections. Create a free account to purchase, save favourites, and manage your HGC wallet.

        .shopper-feature-card
          .shopper-feature-icon
            svg(width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true')
              circle(cx='12' cy='12' r='9' stroke='currentColor' stroke-width='1.8')
              path(d='M12 7v1m0 8v1M9.5 9.5C9.5 8.67 10.67 8 12 8s2.5.67 2.5 1.5S13.33 11 12 11s-2.5.83-2.5 1.5S10.67 15 12 15s2.5-.67 2.5-1.5' stroke='currentColor' stroke-width='1.8' stroke-linecap='round')
          h3.shopper-feature-title Priced in HGC
          p.shopper-feature-desc Every product is priced and sold in HedgeCoin. Fund your balance once and shop everything on the platform with a single currency.

        .shopper-feature-card
          .shopper-feature-icon
            svg(width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true')
              path(d='M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z' stroke='currentColor' stroke-width='1.8')
              path(d='M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round')
          h3.shopper-feature-title Multi-Currency Display
          p.shopper-feature-desc View prices in your local currency alongside HGC. Choose your preferred currency from settings — fully supported in the app and web shop.

        .shopper-feature-card
          .shopper-feature-icon
            svg(width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true')
              path(d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.8a16 16 0 0 0 6 6l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.5 16l.42.92z' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round')
          h3.shopper-feature-title Order Tracking &amp; Notifications
          p.shopper-feature-desc Track every order from placement to delivery. Receive push notifications at each stage so you always know where your purchase is.

        .shopper-feature-card
          .shopper-feature-icon
            svg(width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true')
              rect(x='2' y='3' width='20' height='14' rx='2' ry='2' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round')
              path(d='M8 21h8M12 17v4' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round')
          h3.shopper-feature-title Shop on Any Device
          p.shopper-feature-desc Full experience on web and mobile. Download the iOS or Android app for the best shopping and HGC management experience on the go.

        .shopper-feature-card
          .shopper-feature-icon
            svg(width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true')
              path(d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round')
          h3.shopper-feature-title Secure Payments
          p.shopper-feature-desc All payments are processed by Paystack &mdash; one of Africa&rsquo;s most trusted payment processors. Your card details are never stored on Hedge Wears servers.

  //- ─── HGC CALLOUT ────────────────────────────────────────────────────────────
  section.pricing-note.section.section--dark
    .container
      .pricing-note-inner
        .pricing-note-icon
          img.hgc-icon-card-header(src='/img/hgc-icon.svg' alt='HGC')
        .pricing-note-text
          h3.pricing-note-title All prices in HedgeCoin (HGC)
          p.pricing-note-desc Product prices on Hedge Wears are displayed in HGC &mdash; our transactional currency, running on the Vendorstack coin infrastructure. HGC is not a cryptocurrency; it is simply the platform&rsquo;s mode of payment. Your local currency equivalent is always shown alongside for reference.

  //- ─── FAQ ───────────────────────────────────────────────────────────────────
  section.faq.section
    .container
      .section-header
        span.section-eyebrow Got questions?
        h2.section-title Frequently asked
      .faq-list
        .faq-item
          h3.faq-question What is HedgeCoin (HGC)?
          p.faq-answer HGC is the currency Hedge Wears uses to sell products &mdash; every item on the platform is priced in HGC. It runs on the Vendorstack coin infrastructure that powers the platform and is not a cryptocurrency. You fund your HGC balance from your local currency and every price shows an equivalent in the currency you pick in settings.

        .faq-item
          h3.faq-question How do I get HGC?
          p.faq-answer Fund your wallet using your local currency &mdash; on web or mobile. The conversion rate and any fees are shown before you confirm, and HGC can be converted back to your local currency equivalent at the prevailing rate.

        .faq-item
          h3.faq-question Does my HGC expire?
          p.faq-answer No. Your HGC balance stays in your wallet until you spend it at checkout or convert it back to your local currency. If you plan to close your account, convert your remaining balance first.

        .faq-item
          h3.faq-question What payment methods are accepted?
          p.faq-answer All payments are processed through Paystack. You can pay by debit card, credit card, or bank transfer. Your card details are never stored on Hedge Wears servers.

        .faq-item
          h3.faq-question How do returns work?
          p.faq-answer Return and refund requests are handled through our support team. Contact us at hello@hedgewears.com with your order number and we will assist you promptly.

        .faq-item
          h3.faq-question Is shopping on Hedge Wears free?
          p.faq-answer Yes. There are no subscription fees, membership fees, or browsing fees. Creating an account and purchasing is completely free. You only pay for the products you buy.

  //- ─── CTA ────────────────────────────────────────────────────────────────────
  section.cta-banner.section
    .container
      .cta-banner-inner
        h2.cta-banner-title Ready to shop in HGC?
        p.cta-banner-subtitle Fund your wallet, pick your pieces, and pay in one currency &mdash; wherever you are.
        .cta-banner-actions
          a.btn.btn-white.btn-lg(href=webShopUrl target='_blank' rel='noopener') Shop Now
          a.btn.btn-outline-white.btn-lg(href='/download') Download App
