extends layout

block pageTitle
  title Collections — Hedge Wears

block metaDesc
  meta(name='description' content='Explore curated collections from Hedge Wears — The Meridian Collection, Street & Sport, and more from African designers.')

block structuredData
  +orgAndWebsite()
  +breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Collections', path: '/collections' }])
  +jsonld({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': 'https://hedgewears.com/collections#collection',
    name: 'The Collections — Hedge Wears',
    description: 'Curated seasonal and thematic collections from Hedge Wears — refined classics with cultural weight and contemporary relevance.',
    url: 'https://hedgewears.com/collections',
    isPartOf: { '@id': 'https://hedgewears.com/#website' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: (featuredProducts || []).map(function(p, i) {
        return {
          '@type': 'ListItem',
          position: i + 1,
          name: p.name,
          url: webShopUrl + '/product/' + p._id
        };
      })
    }
  })

block content

  //- ─── HERO ──────────────────────────────────────────────────────────────────
  section.collections-hero.hero--image.section(style=`background-image: url("/img/brand/hero-collections.jpg?v=${version}")`)
    .hero-overlay
    .container
      .collections-hero-inner
        span.section-eyebrow Curated for you
        h1.collections-hero-title The Collections
        p.collections-hero-sub Refined classics with cultural weight and contemporary relevance.

  //- ─── MERIDIAN COLLECTION ───────────────────────────────────────────────────
  section.collection-editorial.section
    .container
      .collection-editorial-inner
        .collection-editorial-img-wrap
          img.collection-editorial-img(src='/img/brand/hedge-24.jpg?v=' + version alt='Model wearing a dress from the Meridian Collection' loading='lazy')
        .collection-editorial-content
          span.section-eyebrow Collection 01
          h2.collection-editorial-title The Meridian Collection
          p.collection-editorial-desc Flowing silhouettes, deliberate cuts, and a palette drawn from natural textures. The Meridian Collection is for those who move with intention. Each piece is designed to carry you from morning markets to evening gatherings without compromise.
          a.btn.btn-primary(href=webShopUrl target='_blank' rel='noopener') Shop Meridian

  //- ─── STREET & SPORT ────────────────────────────────────────────────────────
  section.collection-editorial.section.section--muted
    .container
      .collection-editorial-inner.collection-editorial-inner--reverse
        .collection-editorial-content
          span.section-eyebrow Collection 02
          h2.collection-editorial-title Street &amp; Sport
          p.collection-editorial-desc Bold colourways and relaxed fits built for the city. Street &amp; Sport blends performance silhouettes with fashion-forward details — sneakers, crossbodies, and layered separates that hold up wherever the day takes you.
          a.btn.btn-primary(href=webShopUrl target='_blank' rel='noopener') Shop Street &amp; Sport
        .collection-editorial-img-pair
          img.collection-editorial-img.collection-editorial-img--half(src='/img/brand/hedge-65.jpg?v=' + version alt="Women's shoes from the Street and Sport collection" loading='lazy')
          img.collection-editorial-img.collection-editorial-img--half(src='/img/brand/hedge-66.jpg?v=' + version alt="Men's shoes from the Street and Sport collection" loading='lazy')

  //- ─── COLLECTION PICKS ──────────────────────────────────────────────────────
  section.collection-picks.section
    .container
      .section-header
        span.section-eyebrow From the collections
        h2.section-title Standout Pieces
      .products-grid
        if featuredProducts && featuredProducts.length > 0
          each product, i in featuredProducts.slice(0, 4)
            - const imgUrl = product.photo || (product.thumbnailPhotos && product.thumbnailPhotos[0]) || (product.photos && product.photos[0]) || ('/img/brand/hedge-27.jpg?v=' + version)
            a.product-card(href=webShopUrl + '/product/' + product._id target='_blank' rel='noopener')
              .product-card-img-wrap
                if product.video
                  video.product-card-img(src=product.video autoplay muted loop playsinline aria-label=product.name)
                else
                  img.product-card-img(src=imgUrl alt=product.name loading='lazy')
              .product-card-info
                span.product-card-name= product.name
                span.product-price
                  img.hgc-icon-inline(src='/img/hgc-icon.svg?v=' + version alt='HGC')
                  = product.sellingPriceCoin
              span.product-card-link View →
        else
          a.product-card(href=webShopUrl target='_blank' rel='noopener')
            .product-card-img-wrap
              img.product-card-img(src='/img/brand/hedge-28.jpg?v=' + version alt='Meridian Dress' loading='lazy')
            .product-card-info
              span.product-card-name Meridian Dress
              span.product-price
                img.hgc-icon-inline(src='/img/hgc-icon.svg?v=' + version alt='HGC')
                | 280
            span.product-card-link View →
          a.product-card(href=webShopUrl target='_blank' rel='noopener')
            .product-card-img-wrap
              img.product-card-img(src='/img/brand/hedge-29.jpg?v=' + version alt='Street Sneakers' loading='lazy')
            .product-card-info
              span.product-card-name Street Sneakers
              span.product-price
                img.hgc-icon-inline(src='/img/hgc-icon.svg?v=' + version alt='HGC')
                | 320
            span.product-card-link View →
          a.product-card(href=webShopUrl target='_blank' rel='noopener')
            .product-card-img-wrap
              img.product-card-img(src='/img/brand/hedge-31.jpg?v=' + version alt='Structured Tote' loading='lazy')
            .product-card-info
              span.product-card-name Structured Tote
              span.product-price
                img.hgc-icon-inline(src='/img/hgc-icon.svg?v=' + version alt='HGC')
                | 410
            span.product-card-link View →
          a.product-card(href=webShopUrl target='_blank' rel='noopener')
            .product-card-img-wrap
              img.product-card-img(src='/img/brand/hedge-32.jpg?v=' + version alt='Tailored Blazer' loading='lazy')
            .product-card-info
              span.product-card-name Tailored Blazer
              span.product-price
                img.hgc-icon-inline(src='/img/hgc-icon.svg?v=' + version alt='HGC')
                | 360
            span.product-card-link View →
      .section-footer-cta
        a.btn.btn-primary(href=webShopUrl target='_blank' rel='noopener') View all collections →
