extends layout

block pageTitle
  title Our Products — Hedge Wears

block metaDesc
  meta(name='description' content='Discover fashion from African designers on Hedge Wears. Browse bags, shoes, dresses, jewelry and more — priced in HGC.')

block structuredData
  +orgAndWebsite()
  +breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Products', path: '/products' }])
  +jsonld({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': 'https://hedgewears.com/products#collection',
    name: 'Our Products — Hedge Wears',
    description: 'The full Hedge Wears catalogue of premium African fashion — apparel, footwear, and accessories, priced in HedgeCoin (HGC).',
    url: 'https://hedgewears.com/products',
    isPartOf: { '@id': 'https://hedgewears.com/#website' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: (featuredProducts || []).map(function(p, i) {
        return {
          '@type': 'ListItem',
          position: i + 1,
          name: p.name,
          url: webShopUrl + '/product/' + p._id
        };
      })
    }
  })

block content

  //- ─── PAGE HERO ─────────────────────────────────────────────────────────────
  section.page-hero.section
    .container
      .page-hero-inner.page-hero-inner--centered
        span.section-eyebrow The Full Catalogue
        h1.page-hero-title Our Products
        p.page-hero-subtitle Discover fashion from African designers. Every item priced in HGC — with your local currency equivalent always shown.

  //- ─── FILTER TAGS ───────────────────────────────────────────────────────────
  if tags && tags.length > 0
    section.filter-tags.section
      .container
        .tags-row
          each tag in tags
            a.tag-pill(href=webShopUrl + '/?tags=' + tag._id target='_blank' rel='noopener')= tag.name

  //- ─── PRODUCT GRID ──────────────────────────────────────────────────────────
  section.products-section.section
    .container
      - const placeholderImages = [('/img/brand/hedge-36.jpg?v=' + version), ('/img/brand/hedge-38.jpg?v=' + version), ('/img/brand/hedge-39.jpg?v=' + version), ('/img/brand/hedge-40.jpg?v=' + version), ('/img/brand/hedge-41.jpg?v=' + version), ('/img/brand/hedge-42.jpg?v=' + version), ('/img/brand/hedge-43.jpg?v=' + version), ('/img/brand/hedge-44.jpg?v=' + version)]
      - const placeholderNames = ['Meridian Dress', 'Street Sneakers', 'Gold Layer Set', 'Structured Tote', 'Block Heel Mule', 'Derby Oxford', 'Tailored Blazer', 'Leather Shoulder Bag']
      - const placeholderPrices = [280, 320, 150, 410, 240, 290, 360, 380]
      .products-grid
        if featuredProducts && featuredProducts.length > 0
          each product in featuredProducts
            - const imgUrl = product.photo || (product.thumbnailPhotos && product.thumbnailPhotos[0]) || (product.photos && product.photos[0]) || ('/img/brand/hedge-47.jpg?v=' + version)
            a.product-card(href=webShopUrl + '/product/' + product._id target='_blank' rel='noopener')
              .product-card-img-wrap
                if product.video
                  video.product-card-img(src=product.video autoplay muted loop playsinline aria-label=product.name)
                else
                  img.product-card-img(src=imgUrl alt=product.name loading='lazy')
              .product-card-info
                span.product-card-name= product.name
                span.product-price
                  img.hgc-icon-inline(src='/img/hgc-icon.svg' alt='HGC')
                  = product.sellingPriceCoin
              span.product-card-link View →
        else
          each imgSrc, i in placeholderImages
            a.product-card(href=webShopUrl target='_blank' rel='noopener')
              .product-card-img-wrap
                img.product-card-img(src=imgSrc alt=placeholderNames[i] loading='lazy')
              .product-card-info
                span.product-card-name= placeholderNames[i]
                span.product-price
                  img.hgc-icon-inline(src='/img/hgc-icon.svg' alt='HGC')
                  = placeholderPrices[i]
              span.product-card-link View →
      .section-footer-cta
        a.btn.btn-primary.btn-lg(href=webShopUrl target='_blank' rel='noopener') Browse all in the store
