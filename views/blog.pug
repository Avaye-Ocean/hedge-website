extends layout

block pageTitle
  title Stories &amp; Updates — Hedge Wears

block metaDesc
  meta(name='description' content='Stories, updates, and style guides from the Hedge Wears team. Fashion, culture, and business from Africa and beyond.')

block structuredData
  +orgAndWebsite()
  +breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }])

block content

  //- ─── PAGE HERO ─────────────────────────────────────────────────────────────
  section.page-hero.section
    .container
      .page-hero-inner.page-hero-inner--centered
        span.section-eyebrow Our journal
        h1.page-hero-title Stories &amp; Updates
        p.page-hero-subtitle Fashion, culture, and business from the Hedge Wears community.

  //- ─── BLOG POSTS ─────────────────────────────────────────────────────────────
  //- Blog articles are not individually published yet — cards are non-linked previews.
  //- When article pages exist, swap article.blog-card back to a.blog-card(href='/blog/slug').
  section.section
    .container
      .blog-grid
        article.blog-card
          .blog-card-img-wrap
            img.blog-card-img(
              src='/img/brand/hedge-33.jpg?v=' + version
              alt='Understanding HedgeCoin: the currency behind Hedge Wears'
              loading='lazy'
            )
          .blog-card-body
            span.blog-card-date May 2025
            h2.blog-card-title Understanding HedgeCoin: the currency behind Hedge Wears
            p.blog-card-excerpt Every product on Hedge Wears is priced and sold in HedgeCoin. Here's how the coin works — funding your balance from your local currency, converting back at the live rate, and what it means at checkout.

        article.blog-card
          .blog-card-img-wrap
            img.blog-card-img(
              src='/img/brand/hedge-34.jpg?v=' + version
              alt='Meet the designers behind the Meridian Collection'
              loading='lazy'
            )
          .blog-card-body
            span.blog-card-date April 2025
            h2.blog-card-title Meet the designers behind the Meridian Collection
            p.blog-card-excerpt The Meridian Collection took eight months to develop — from initial sketches in Lagos to final samples reviewed in London. We sat down with the creative team.

        article.blog-card
          .blog-card-img-wrap
            img.blog-card-img(
              src='/img/brand/hedge-35.jpg?v=' + version
              alt='Why we built HedgeCoin — a note from our founder'
              loading='lazy'
            )
          .blog-card-body
            span.blog-card-date March 2025
            h2.blog-card-title Why we built HedgeCoin
            p.blog-card-excerpt We wanted one currency that works the same for every shopper, everywhere — built on Vendorstack's coin infrastructure, not a blockchain. A note from our founder on why we sell in HGC.

      p.blog-coming-soon More stories coming soon. Follow us on Instagram
        a.link(href='https://instagram.com/hedgewears' target='_blank' rel='noopener')  @hedgewears
        |  for the latest.
